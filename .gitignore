# Our playground: correspondence, Astra's die review, experiments and the attic.
# It stays on this machine and never shows as tracked.
investigation/

# Where this machine keeps things outside the repo (tools/repo_paths.py reads it;
# paths.local.example is the tracked template).
paths.local

# The coding assistants' own per-project folders (settings, memory, notes): local only.
.claude/
.codex/

# Firmware is not committed; the released add-ons carry it (Tomi's decision, 2026-09-26).
# Anyone building from source puts their own copies in firmware/<device>/ (see the README
# there).  The rule is blunt on purpose, so nothing lands here by accident.
*.hex
*.HEX
*.bns
*.tns
*.TNS
*.BNS
*.dvc
*.DVC
*.sys
*.SYS
*.rom
*.bin
*.state
firmware/gw-micro-speakout/*
!firmware/gw-micro-speakout/README.txt
firmware/gw-micro-sounding-board/*
!firmware/gw-micro-sounding-board/README.txt
firmware/automated-functions-smartalk/*
!firmware/automated-functions-smartalk/README.txt
firmware/blazie/*
!firmware/blazie/README.txt
# Sweet Micro Systems' (the Mockingboard's), treated as Blazie's (Tomi, 2026-10-09), and Apple II disk images (the
# toolkit disk also carries Apple's DOS 3.3; .po and .do ones are covered in the folder, as *.po would hide gettext's)
firmware/sweet-micro-mockingboard/*
!firmware/sweet-micro-mockingboard/README.txt
*.dsk
# Speech Systems' Super Voice (1984): its disk's files, whatever their case (SUPERTOK.BIN; *.bin above is lower case)
firmware/speech-systems-super-voice/*
!firmware/speech-systems-super-voice/README.txt
*.DSK

# The stand-alone Accent SA's two ROMs (read by Kevin from his own unit): a drop-in folder until the voice ships
firmware/aicom-accent-sa-z80/*
!firmware/aicom-accent-sa-z80/README.txt

# Artic's VEST.COM (and TVISION.COM) for the SynPhonix research host: a drop-in folder while Artic's founders are
# asked (docs/history.md, "Who speaks for Artic"); each copy carries its card's serial
firmware/artic-synphonix/*
!firmware/artic-synphonix/README.txt

# The exception: Aicom's software, kept in the tree with its notice (firmware/AICOM.txt).
!firmware/aicom-accent-sa/*.BIN
!firmware/aicom-accent-mini/SPKEMS.DVC

# Built add-ons bundle that firmware: they go out as release assets, never committed.
nvda/dist/
*.nvda-addon

# The old-NVDA test rig holds NV Access's binaries (nvda2021app, nvda2023app) and the
# embeddable Python: local only.  Its script and README are tracked.
nvda/tools/win7/*
!nvda/tools/win7/README.txt
!nvda/tools/win7/run37.py

# Renders and test output
investigation/out/
nvda/tools/out/
*.wav

# Native build output: python src/csrc/build_native.py makes ssi263.dll, and the
# Unicorn recipe (nvda/build_speakout.py, UNICORN_BUILD) makes unicorn.dll.
build/
build-*/
*.dll
*.exe
*.o
*.obj
# ./build_linux.sh: libssi263speech.so, copied beside the chip's Python package
*.so
*.lib
*.exp
*.pdb
*.log
prof.out

__pycache__/
*.pyc
.pytest_cache/
.venv/

# macOS Finder's folder settings
.DS_Store
# its disk says to share it: the unmodified TSR is in the repository, under its own notice (README.txt); after *.exe
!firmware/automated-functions-smartalk/S_TALK.EXE
